# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.
#
# There is no AI API key in here on purpose - it's configured at runtime by
# logging in as the sysadmin account and going to Account -> AI Provider.
# See CREDENTIALS.local.txt (generated by `npm run seed`) for the sysadmin
# login.

# Any random long string for session signing
SESSION_SECRET=change_this_to_a_random_string

PORT=3000
