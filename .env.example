# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.
#
# There is no AI API key in here on purpose - it's configured at runtime by
# logging in as the sysadmin account and going to Account -> AI Provider.
# See CREDENTIALS.local.txt (generated by `npm run seed`) for the sysadmin
# login.

# Any random long string for session signing
SESSION_SECRET=change_this_to_a_random_string

# 80 = no ":port" in the URL (http://ventifyfinance.org instead of
# http://ventifyfinance.org:3000). Binding port 80 needs a capability grant
# first - see the README's "Run" section (setcap) before starting on 80.
# Set back to 3000 (or anything else) if you don't want to bother with that.
PORT=80
